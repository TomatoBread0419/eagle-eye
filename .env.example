# 🦅 Eagle Eye V7.1 LTS — 环境变量配置
#
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env
#
# 所有密钥从此文件加载，不再硬编码到代码中。
# 优先级：环境变量 > .env 文件 > 默认值

# ─── Alpaca API（Paper Trading 模拟交易）────────────
# 申请地址: https://app.alpaca.markets/
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets/v2/stocks

# ─── 数据目录 ──────────────────────────────────────
# 默认: ~/stock_trader/
# EAGLE_DATA_DIR=/path/to/data

# ─── 日志 ──────────────────────────────────────────
# 级别: DEBUG / INFO / WARNING / ERROR
EAGLE_LOG_LEVEL=INFO
# EAGLE_LOG_DIR=/path/to/logs
# 最大日志文件大小（字节）
EAGLE_LOG_MAX_BYTES=10485760
# 保留的日志备份数
EAGLE_LOG_BACKUP_COUNT=5

# ─── HTTP ──────────────────────────────────────────
# 读超时（秒）
EAGLE_HTTP_TIMEOUT_READ=30
# 写超时（秒）
EAGLE_HTTP_TIMEOUT_WRITE=10
# 最大重试次数
EAGLE_HTTP_MAX_RETRIES=3
# 重试间隔（秒，指数退避基数）
EAGLE_HTTP_RETRY_DELAY=3

# ─── 交易参数 ──────────────────────────────────────
# 目标总仓位（0.85 = 85%）
EAGLE_TARGET_ALLOCATION=0.85
# 单只最大仓位（0.20 = 20%）
EAGLE_MAX_SINGLE_POSITION=0.20
# 单只最小仓位（0.03 = 3%）
EAGLE_MIN_SINGLE_POSITION=0.03
# 回撤暂停买入阈值（0.12 = 12%）
EAGLE_DRAWDOWN_PAUSE=0.12
# 回撤减半仓阈值（0.20 = 20%）
EAGLE_DRAWDOWN_REDUCE=0.20
# 低仓位强制市价单阈值（0.30 = 30%）
EAGLE_LOW_UTIL_FORCE_MARKET=0.30

# ─── 代理 ──────────────────────────────────────────
# 是否启用 SOCKS5 代理（中国网络环境需要）
EAGLE_PROXY_ENABLED=false
EAGLE_PROXY_HOST=127.0.0.1
EAGLE_PROXY_PORT=7891

# ─── 通知 ──────────────────────────────────────────
# Bark (iOS)
BARK_KEY=
# PushPlus
PUSHPLUS_TOKEN=
# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
