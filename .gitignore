# 🦅 Eagle Eye .gitignore

# 环境变量 / 密钥
.env
.env.*
!env.example
!.env.example

# Python缓存
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# 日志
logs/
*.log

# 本地数据存储
storage/
*.db
*.sqlite
*.sqlite3

# 临时文件
tmp/
*.tmp
*.swp
*.swo

# 操作系统
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# 其他
.pytest_cache/
.mypy_cache/

# 事件驱动交易日志
events_log.json
event_map.json
market_events_latest.json
us_risk_state.json
us_watchlist.json
docs/event-driven-plan.md

# 补丁前备份文件
*.pre-patch-0B
*.pre-patch-3
